{
  "title": "GPU Temperature",
  "uid": "gpu-temperature",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "GPU Temperature (C)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "gpu_temperature_celsius",
          "legendFormat": "{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "max": 110
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      }
    }
  ]
}
